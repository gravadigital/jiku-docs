# jiku-docs — variables de entorno. Copiar a .env (ignorado por git) y completar.
# Los valores de ejemplo son los del stack local de Jiku (jiku/deploy/.env); en prod cambian todos.

# ---- Bus (NATS de Jiku) -------------------------------------------------------------
# URL de NATS. En el compose local se fija a nats://nats:4222 (red jiku-local_jiku).
NATS_URL=nats://localhost:4222
# Creds del sentinel (no dan permisos solos: disparan el auth-callout). En el compose local se monta
# jiku/deploy/nats/creds/sentinel-client.creds en /run/secrets/nats.creds.
NATS_CREDS=../../jiku/deploy/nats/creds/sentinel-client.creds
# Instalación: dev / prod (igual que NATS_INSTANCE de Jiku).
NATS_INSTANCE=dev
# Prefijo de los servicios micro (<nombre>-commands / <nombre>-queries) y valor de serviceName en
# el registro JIKU_MODULES. No cambia los subjects de eventos (docs-events) ni notificaciones.
DOCS_SERVICE_NAME=jiku-docs

# ---- Identidad (machine user jiku_docs, roles internal-app + docs, Access Token Type JWT) ----
# JSON key de Zitadel en base64: base64 -w0 .local/jiku_docs.service_user.json
DOCS_SERVICE_USER_KEY_B64=
# Alternativa a la anterior: ruta al JSON (dentro del contenedor).
DOCS_SERVICE_USER_KEY_FILE=
ZITADEL_ISSUER_URL=https://id.grava.io
ZITADEL_PROJECT_ID=275672248377933829

# ---- Integración con Jiku -------------------------------------------------------------
# user id (sub) del service user de la api: el único caller que puede mandar `actor` y usar
# shares.resolve / shares.attachment (D-2). Local: el userId de jiku/local/api-su.json.
JIKU_API_USER_ID=390014149763006466
# Base de los links estables de adjuntos: {JIKU_WEB_URL}/docs/attachments/{id} (D-5).
JIKU_WEB_URL=http://localhost:3000
# Base de los links compartidos: {JIKU_PUBLIC_URL}/p/docs/{token} (D-5). Local: host distinto de
# localhost para no compartir cookies.
JIKU_PUBLIC_URL=http://127.0.0.1:3100
# Includables de users.list que identifican la clase del caller (requiere el ajuste en core, ver
# README "Requisitos en Jiku"). Default: roles,identityType.
CORE_USER_INCLUDES=roles,identityType
# Timeout de las consultas a core.
CORE_TIMEOUT=10s

# ---- PostgreSQL propio ------------------------------------------------------------------
# Contraseña del Postgres del compose local.
DOCS_DATABASE_PASSWORD=jiku-docs-local
# DSN (en el compose local se arma solo con DOCS_DATABASE_PASSWORD).
DATABASE_URL=postgres://jiku_docs:jiku-docs-local@localhost:5442/jiku_docs?sslmode=disable

# ---- Bucket de contenido (D-4: Spaces en prod, MinIO de Jiku en local) ------------------
# Endpoint que usa el servicio. 172.28.0.1 es el gateway de la red de Jiku: sirve desde
# contenedores y desde el host, y por eso también sirve para firmar URLs.
DOCS_S3_ENDPOINT=http://172.28.0.1:9000
# Opcional: host para el que se firman las URLs prefirmadas, si difiere del anterior.
DOCS_S3_PUBLIC_ENDPOINT=
DOCS_S3_REGION=us-east-1
DOCS_S3_BUCKET=jiku-docs-content
DOCS_S3_ACCESS_KEY=jiku-local
DOCS_S3_SECRET_KEY=jiku-local-secret
DOCS_S3_FORCE_PATH_STYLE=true
# Días que papelera/ guarda lo que el servicio borra (versiones compactadas, contenido huérfano,
# documentos purgados) antes de que la regla de ciclo de vida lo expire. La aplica
# `jiku-docs storage init`; cambiarla requiere volver a correrlo.
DOCS_TRASH_RETENTION_DAYS=7

# ---- Secreto del servicio -----------------------------------------------------------------
# 32 bytes aleatorios en base64: cifra el token de reintento de shares.new (5 min) y es la clave
# del HMAC de las IPs de acceso a links. openssl rand -base64 32
DOCS_SECRET_KEY=

# ---- Operación ---------------------------------------------------------------------------
# /healthz, /readyz y /metrics.
DOCS_HTTP_ADDR=:8080
LOG_LEVEL=info
DOCS_INDEXER_ENABLED=true
DOCS_JANITOR_ENABLED=true
DOCS_OUTBOX_ENABLED=true
# Hora UTC de la revisión diaria de relaciones contra core.
DOCS_RELATION_REVIEW_HOUR_UTC=6

# ---- Compactación del historial (docs/history-compaction-v1.md) -------------------------
# Activa el proceso diario (el comando `jiku-docs history compact` funciona igual con false).
DOCS_HISTORY_COMPACTION_ENABLED=true
# Hora del día (en DOCS_HISTORY_TIMEZONE) a partir de la cual corre la ejecución diaria.
DOCS_HISTORY_COMPACTION_HOUR=3
# Zona de la hora de ejecución y de los días calendario de la retención.
DOCS_HISTORY_TIMEZONE=America/Argentina/Buenos_Aires
# Ventana en la que se conservan todas las versiones (duración Go; acepta d para días).
DOCS_HISTORY_KEEP_ALL=24h
# Hasta qué antigüedad se conserva la última versión de cada bloque de edición.
DOCS_HISTORY_KEEP_BLOCKS=30d
# Pausa que cierra un bloque de edición.
DOCS_HISTORY_BLOCK_GAP=30m
# Documentos por lote.
DOCS_HISTORY_BATCH_SIZE=100
# Objetos por lote al mover versiones compactadas a papelera/ (copias en paralelo y una
# llamada a DeleteObjects de los originales; máximo 1000).
DOCS_HISTORY_S3_DELETE_BATCH=1000

# ---- Importador HedgeDoc (solo `jiku-docs import hedgedoc`) ---------------------------------
HEDGEDOC_MYSQL_DSN=root:hedgedoc@tcp(127.0.0.1:33306)/codimd?parseTime=true&charset=utf8mb4
