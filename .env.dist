# jiku-docs — environment variables. Copy to .env (ignored by git) and fill in.
# The example values are those of Jiku's local stack (jiku/deploy/.env); in prod they all change.

# ---- Bus (Jiku's NATS) --------------------------------------------------------------
# NATS URL. The local compose sets it to nats://nats:4222 (jiku-local_jiku network).
NATS_URL=nats://localhost:4222
# Sentinel creds (they grant no permissions on their own: they trigger the auth-callout). The local
# compose mounts jiku/deploy/nats/creds/sentinel-client.creds at /run/secrets/nats.creds.
NATS_CREDS=../../jiku/deploy/nats/creds/sentinel-client.creds
# Installation: dev / prod (same as Jiku's NATS_INSTANCE).
NATS_INSTANCE=dev
# Prefix of the micro services (<name>-commands / <name>-queries) and value of serviceName in the
# JIKU_MODULES registry. It does not change the subjects of events (docs-events) or notifications.
DOCS_SERVICE_NAME=jiku-docs

# ---- Identity (machine user jiku_docs, roles internal-app + docs, Access Token Type JWT) ----
# Zitadel JSON key in base64: base64 -w0 .local/jiku_docs.service_user.json
DOCS_SERVICE_USER_KEY_B64=
# Alternative to the previous one: path to the JSON (inside the container).
DOCS_SERVICE_USER_KEY_FILE=
ZITADEL_ISSUER_URL=https://id.grava.io
ZITADEL_PROJECT_ID=275672248377933829

# ---- Integration with Jiku -----------------------------------------------------------
# user id (sub) of the api's service user: the only caller that can send `actor` and use
# shares.resolve / shares.attachment (D-2). Local: the userId in jiku/local/api-su.json.
JIKU_API_USER_ID=390014149763006466
# Base of the stable attachment links: {JIKU_WEB_URL}/docs/attachments/{id} (D-5).
JIKU_WEB_URL=http://localhost:3000
# Base of the share links: {JIKU_PUBLIC_URL}/p/docs/{token} (D-5). Local: a host other than
# localhost so cookies are not shared.
JIKU_PUBLIC_URL=http://127.0.0.1:3100
# users.list includables that identify the caller's class (requires the change in core, see the
# README, "Requirements in Jiku"). Default: roles,identityType.
CORE_USER_INCLUDES=roles,identityType
# Timeout of the queries to core.
CORE_TIMEOUT=10s

# ---- Own PostgreSQL ---------------------------------------------------------------------
# Password of the local compose's Postgres.
DOCS_DATABASE_PASSWORD=jiku-docs-local
# DSN (the local compose builds it on its own from DOCS_DATABASE_PASSWORD).
DATABASE_URL=postgres://jiku_docs:jiku-docs-local@localhost:5442/jiku_docs?sslmode=disable

# ---- Content bucket (D-4: Spaces in prod, Jiku's MinIO locally) -------------------------
# Endpoint the service uses. 172.28.0.1 is the gateway of Jiku's network: it works from
# containers and from the host, and that is why it also works for signing URLs.
DOCS_S3_ENDPOINT=http://172.28.0.1:9000
# Optional: host the presigned URLs are signed for, if it differs from the previous one.
DOCS_S3_PUBLIC_ENDPOINT=
DOCS_S3_REGION=us-east-1
DOCS_S3_BUCKET=jiku-docs-content
DOCS_S3_ACCESS_KEY=jiku-local
DOCS_S3_SECRET_KEY=jiku-local-secret
DOCS_S3_FORCE_PATH_STYLE=true
# Days trash/ keeps what the service deletes (pruned versions, orphaned content, purged
# documents) before the lifecycle rule expires it. `jiku-docs storage init` applies it;
# changing it requires running it again.
DOCS_TRASH_RETENTION_DAYS=7

# ---- Service secret ----------------------------------------------------------------------
# 32 random bytes in base64: it encrypts the shares.new retry token (5 min) and is the key of
# the HMAC of the link access IPs. openssl rand -base64 32
DOCS_SECRET_KEY=

# ---- Operations --------------------------------------------------------------------------
# /healthz, /readyz and /metrics.
DOCS_HTTP_ADDR=:8080
LOG_LEVEL=info
DOCS_INDEXER_ENABLED=true
DOCS_JANITOR_ENABLED=true
DOCS_OUTBOX_ENABLED=true
# UTC hour of the daily review of relations against core.
DOCS_RELATION_REVIEW_HOUR_UTC=6

# ---- History compaction (docs/history-compaction-v1.md) ---------------------------------
# Enables the daily process (the `jiku-docs history compact` command works anyway with false).
DOCS_HISTORY_COMPACTION_ENABLED=true
# Hour of the day (in DOCS_HISTORY_TIMEZONE) from which the daily run starts.
DOCS_HISTORY_COMPACTION_HOUR=3
# Time zone of the run hour and of the retention's calendar days.
DOCS_HISTORY_TIMEZONE=America/Argentina/Buenos_Aires
# Window in which all versions are kept (Go duration; accepts d for days).
DOCS_HISTORY_KEEP_ALL=24h
# Age up to which the last version of each editing block is kept.
DOCS_HISTORY_KEEP_BLOCKS=30d
# Pause that closes an editing block.
DOCS_HISTORY_BLOCK_GAP=30m
# Documents per batch.
DOCS_HISTORY_BATCH_SIZE=100
# Objects per batch when moving pruned versions to trash/ (parallel copies and one
# DeleteObjects call for the originals; at most 1000).
DOCS_HISTORY_S3_DELETE_BATCH=1000

# ---- HedgeDoc importer (only `jiku-docs import hedgedoc`) -----------------------------------
HEDGEDOC_MYSQL_DSN=root:hedgedoc@tcp(127.0.0.1:33306)/codimd?parseTime=true&charset=utf8mb4
